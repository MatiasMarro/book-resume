# Copiá este archivo a apps/api/.dev.vars para desarrollo local del Worker.
# En producción las API keys van con `wrangler secret put NOMBRE`,
# NUNCA en wrangler.toml ni en el cliente.
#
# Regla dura: el model ID nunca se hardcodea en el código. Siempre por env.

GOOGLE_BOOKS_KEY=

LLM_ENABLED=true
LLM_PROVIDER=fixture          # cabeza: 'openai' | 'workersai' | 'fixture'
LLM_MODEL=gpt-5.6-luna
LLM_PROVIDER_TAIL=fixture     # cola larga; en producción: workersai
LLM_MODEL_TAIL=gpt-5.6-luna   # con workersai, el ID real: '@cf/…'
OPENAI_API_KEY=
GOOGLE_AI_STUDIO_KEY=

# Solo para `npm run check:models` con el proveedor workersai: el binding AI
# corre inferencia pero no lista modelos, y el catálogo vive en la API de
# Cloudflare. Sin esto, la verificación del modelo de la cola queda
# 'no-verificable' y hay que correr el chequeo a mano antes de deployar.
CF_ACCOUNT_ID=
CF_API_TOKEN=
